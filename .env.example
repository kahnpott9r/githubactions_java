# Copy thành .env để đổi cấu hình docker compose (KHÔNG commit file .env).

# Port trên máy host
NODE_PORT=3000
JAVA_PORT=8080
MINISTACK_PORT=4567
STACKPORT_PORT=8090

MINISTACK_IMAGE=ministackorg/ministack:latest
STACKPORT_IMAGE=davireis/stackport:latest

# Danh sách service StackPort quét (ít service = UI tải nhanh hơn)
STACKPORT_SERVICES=s3,sqs,sns,dynamodb,lambda,iam,logs,ssm,secretsmanager,events
