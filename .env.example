# Copy thành .env để đổi cấu hình docker compose (KHÔNG commit file .env).

# Port trên máy host
NODE_PORT=3000
JAVA_PORT=8080
LOCALSTACK_PORT=4566
MINISTACK_PORT=4567

# LocalStack từ 2026 bản "latest" bắt buộc auth token.
# Mặc định dùng 4.14 (bản community cuối, chạy không cần token).
# Muốn dùng bản mới: đặt LOCALSTACK_IMAGE=localstack/localstack:latest và LOCALSTACK_AUTH_TOKEN.
LOCALSTACK_IMAGE=localstack/localstack:4.14
LOCALSTACK_AUTH_TOKEN=

MINISTACK_IMAGE=ministackorg/ministack:latest
